{
  "$defs": {
    "ATCDecision": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/ATCDecisionType"
        },
        "incident_id": {
          "format": "uuid",
          "title": "Incident Id",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "operator_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Operator Id",
          "type": "string"
        },
        "requested_action": {
          "$ref": "#/$defs/SimulatorActionType"
        },
        "scenario_run_id": {
          "format": "uuid",
          "title": "Scenario Run Id",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "scenario_run_id",
        "incident_id",
        "decision",
        "requested_action",
        "operator_id",
        "issued_at"
      ],
      "title": "ATCDecision",
      "type": "object"
    },
    "ATCDecisionType": {
      "enum": [
        "APPROVE",
        "REJECT"
      ],
      "title": "ATCDecisionType",
      "type": "string"
    },
    "ATCLinkChangedPayload": {
      "additionalProperties": false,
      "properties": {
        "atc_link_connected": {
          "title": "Atc Link Connected",
          "type": "boolean"
        },
        "changed_at": {
          "format": "date-time",
          "title": "Changed At",
          "type": "string"
        },
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "atc_link_connected",
        "changed_at"
      ],
      "title": "ATCLinkChangedPayload",
      "type": "object"
    },
    "AircraftTelemetry": {
      "additionalProperties": false,
      "properties": {
        "active_warning_codes": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Active Warning Codes",
          "type": "array"
        },
        "aircraft_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Aircraft Id",
          "type": "string"
        },
        "airspeed_kts": {
          "maximum": 800.0,
          "minimum": 0.0,
          "title": "Airspeed Kts",
          "type": "number"
        },
        "altitude_ft": {
          "maximum": 70000.0,
          "minimum": -1500.0,
          "title": "Altitude Ft",
          "type": "number"
        },
        "flight_phase": {
          "$ref": "#/$defs/FlightPhase"
        },
        "heading_deg": {
          "exclusiveMaximum": 360.0,
          "minimum": 0.0,
          "title": "Heading Deg",
          "type": "number"
        },
        "latitude": {
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Longitude",
          "type": "number"
        },
        "simulation_time": {
          "format": "date-time",
          "title": "Simulation Time",
          "type": "string"
        }
      },
      "required": [
        "aircraft_id",
        "simulation_time",
        "altitude_ft",
        "airspeed_kts",
        "heading_deg",
        "latitude",
        "longitude",
        "flight_phase",
        "active_warning_codes"
      ],
      "title": "AircraftTelemetry",
      "type": "object"
    },
    "AuthorizationSource": {
      "enum": [
        "NONE",
        "SIMULATED_ATC",
        "LOCAL_FALLBACK"
      ],
      "title": "AuthorizationSource",
      "type": "string"
    },
    "DecisionResult": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "EXECUTED",
        "FAILED"
      ],
      "title": "DecisionResult",
      "type": "string"
    },
    "EventSource": {
      "enum": [
        "SYSTEM",
        "SCENARIO",
        "VISION",
        "SIMULATOR",
        "GUARDIAN",
        "SENTINEL",
        "PILOT",
        "SIMULATED_ATC"
      ],
      "title": "EventSource",
      "type": "string"
    },
    "EventType": {
      "enum": [
        "SCENARIO_STARTED",
        "SCENARIO_ADVANCED",
        "PILOT_OBSERVATION",
        "TELEMETRY_UPDATED",
        "PILOT_ACKNOWLEDGED",
        "ATC_LINK_CHANGED",
        "GUARDIAN_INCIDENT",
        "ATC_DECISION",
        "SENTINEL_DECISION",
        "SIMULATOR_ACTION",
        "SCENARIO_RESET",
        "SCENARIO_COMPLETED"
      ],
      "title": "EventType",
      "type": "string"
    },
    "FlightPhase": {
      "enum": [
        "PREFLIGHT",
        "CRUISE",
        "DESCENT",
        "COMPLETED"
      ],
      "title": "FlightPhase",
      "type": "string"
    },
    "GuardianIncident": {
      "additionalProperties": false,
      "properties": {
        "acknowledgement_required": {
          "title": "Acknowledgement Required",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "explanation": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "guardian_state": {
          "$ref": "#/$defs/GuardianState"
        },
        "incident_id": {
          "format": "uuid",
          "title": "Incident Id",
          "type": "string"
        },
        "incident_type": {
          "$ref": "#/$defs/IncidentType"
        },
        "scenario_run_id": {
          "format": "uuid",
          "title": "Scenario Run Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IncidentSeverity"
        }
      },
      "required": [
        "incident_id",
        "scenario_run_id",
        "incident_type",
        "severity",
        "guardian_state",
        "evidence_event_ids",
        "explanation",
        "acknowledgement_required",
        "created_at"
      ],
      "title": "GuardianIncident",
      "type": "object"
    },
    "GuardianState": {
      "enum": [
        "NORMAL",
        "SUSPECTED",
        "AWAITING_ACK",
        "ESCALATED",
        "RECOVERING"
      ],
      "title": "GuardianState",
      "type": "string"
    },
    "IncidentSeverity": {
      "enum": [
        "WARNING",
        "CRITICAL"
      ],
      "title": "IncidentSeverity",
      "type": "string"
    },
    "IncidentType": {
      "enum": [
        "PILOT_RESPONSE_REQUIRED",
        "DUAL_PILOT_UNRESPONSIVE"
      ],
      "title": "IncidentType",
      "type": "string"
    },
    "PilotAcknowledgement": {
      "additionalProperties": false,
      "properties": {
        "acknowledged_at": {
          "format": "date-time",
          "title": "Acknowledged At",
          "type": "string"
        },
        "alert_id": {
          "format": "uuid",
          "title": "Alert Id",
          "type": "string"
        },
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "pilot_id": {
          "$ref": "#/$defs/PilotId"
        },
        "scenario_run_id": {
          "format": "uuid",
          "title": "Scenario Run Id",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "scenario_run_id",
        "pilot_id",
        "alert_id",
        "acknowledged_at"
      ],
      "title": "PilotAcknowledgement",
      "type": "object"
    },
    "PilotId": {
      "enum": [
        "PILOT_1",
        "PILOT_2"
      ],
      "title": "PilotId",
      "type": "string"
    },
    "PilotObservation": {
      "additionalProperties": false,
      "properties": {
        "camera_available": {
          "title": "Camera Available",
          "type": "boolean"
        },
        "eyes_closed": {
          "title": "Eyes Closed",
          "type": "boolean"
        },
        "face_visible": {
          "title": "Face Visible",
          "type": "boolean"
        },
        "observation_duration_ms": {
          "maximum": 600000,
          "minimum": 0,
          "title": "Observation Duration Ms",
          "type": "integer"
        },
        "observation_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Observation Quality",
          "type": "number"
        },
        "observation_status": {
          "$ref": "#/$defs/PilotObservationStatus"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "pilot_id": {
          "$ref": "#/$defs/PilotId"
        }
      },
      "required": [
        "pilot_id",
        "observed_at",
        "observation_status",
        "camera_available",
        "face_visible",
        "eyes_closed",
        "observation_duration_ms",
        "observation_quality"
      ],
      "title": "PilotObservation",
      "type": "object"
    },
    "PilotObservationStatus": {
      "enum": [
        "RESPONSIVE",
        "POSSIBLY_UNRESPONSIVE",
        "UNKNOWN"
      ],
      "title": "PilotObservationStatus",
      "type": "string"
    },
    "ScenarioAdvancedPayload": {
      "additionalProperties": false,
      "properties": {
        "delta_ms": {
          "maximum": 600000,
          "minimum": 1,
          "title": "Delta Ms",
          "type": "integer"
        },
        "virtual_time": {
          "format": "date-time",
          "title": "Virtual Time",
          "type": "string"
        }
      },
      "required": [
        "delta_ms",
        "virtual_time"
      ],
      "title": "ScenarioAdvancedPayload",
      "type": "object"
    },
    "ScenarioCompletedPayload": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "completed_at"
      ],
      "title": "ScenarioCompletedPayload",
      "type": "object"
    },
    "ScenarioResetPayload": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "new_scenario_run_id": {
          "format": "uuid",
          "title": "New Scenario Run Id",
          "type": "string"
        },
        "previous_scenario_run_id": {
          "format": "uuid",
          "title": "Previous Scenario Run Id",
          "type": "string"
        },
        "reset_at": {
          "format": "date-time",
          "title": "Reset At",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "previous_scenario_run_id",
        "new_scenario_run_id",
        "reset_at"
      ],
      "title": "ScenarioResetPayload",
      "type": "object"
    },
    "ScenarioStartedPayload": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "started_at"
      ],
      "title": "ScenarioStartedPayload",
      "type": "object"
    },
    "SentinelDecision": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "$ref": "#/$defs/SimulatorActionType"
        },
        "authorization_source": {
          "$ref": "#/$defs/AuthorizationSource"
        },
        "decision_id": {
          "format": "uuid",
          "title": "Decision Id",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        },
        "incident_id": {
          "format": "uuid",
          "title": "Incident Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/DecisionResult"
        },
        "scenario_run_id": {
          "format": "uuid",
          "title": "Scenario Run Id",
          "type": "string"
        },
        "sentinel_state": {
          "$ref": "#/$defs/SentinelState"
        }
      },
      "required": [
        "decision_id",
        "scenario_run_id",
        "incident_id",
        "sentinel_state",
        "action_type",
        "authorization_source",
        "reason",
        "evidence_event_ids",
        "executed_at",
        "result"
      ],
      "title": "SentinelDecision",
      "type": "object"
    },
    "SentinelState": {
      "enum": [
        "STANDBY",
        "AWAITING_ATC",
        "LOCAL_FALLBACK",
        "SIM_ACTION_RUNNING",
        "COMPLETED",
        "ABORTED"
      ],
      "title": "SentinelState",
      "type": "string"
    },
    "SimulatorActionPayload": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "format": "uuid",
          "title": "Action Id",
          "type": "string"
        },
        "action_type": {
          "$ref": "#/$defs/SimulatorActionType"
        },
        "applied_at": {
          "format": "date-time",
          "title": "Applied At",
          "type": "string"
        },
        "authorization_source": {
          "$ref": "#/$defs/AuthorizationSource"
        },
        "authorized": {
          "title": "Authorized",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/DecisionResult"
        },
        "scenario_run_id": {
          "format": "uuid",
          "title": "Scenario Run Id",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "scenario_run_id",
        "action_type",
        "authorization_source",
        "authorized",
        "result",
        "reason",
        "applied_at"
      ],
      "title": "SimulatorActionPayload",
      "type": "object"
    },
    "SimulatorActionType": {
      "enum": [
        "NO_OP",
        "SIM_HOLD_STATE",
        "SIM_STABILIZE",
        "SIM_SCRIPTED_DIVERSION",
        "SIM_ABORT"
      ],
      "title": "SimulatorActionType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "causation_event_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Event Id"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScenarioStartedPayload"
        },
        {
          "$ref": "#/$defs/ScenarioAdvancedPayload"
        },
        {
          "$ref": "#/$defs/PilotObservation"
        },
        {
          "$ref": "#/$defs/AircraftTelemetry"
        },
        {
          "$ref": "#/$defs/PilotAcknowledgement"
        },
        {
          "$ref": "#/$defs/ATCLinkChangedPayload"
        },
        {
          "$ref": "#/$defs/GuardianIncident"
        },
        {
          "$ref": "#/$defs/ATCDecision"
        },
        {
          "$ref": "#/$defs/SentinelDecision"
        },
        {
          "$ref": "#/$defs/SimulatorActionPayload"
        },
        {
          "$ref": "#/$defs/ScenarioResetPayload"
        },
        {
          "$ref": "#/$defs/ScenarioCompletedPayload"
        }
      ],
      "title": "Payload"
    },
    "scenario_run_id": {
      "format": "uuid",
      "title": "Scenario Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/EventSource"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "source",
    "scenario_run_id",
    "correlation_id",
    "payload"
  ],
  "title": "DomainEvent",
  "type": "object"
}
